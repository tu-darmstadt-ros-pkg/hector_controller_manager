<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hector_controller_manager</name>
  <version>0.1.0</version>
  <description>Controller manager built as a declarative reconciler on the ros2_control plugin interfaces</description>
  <maintainer email="schmidt@sim.tu-darmstadt.de">Aljoscha Schmidt</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>controller_interface</depend>
  <depend>controller_manager_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>hardware_interface</depend>
  <depend>joint_limits</depend>
  <depend>lifecycle_msgs</depend>
  <depend>pal_statistics</depend>
  <depend>pluginlib</depend>
  <depend>rcl</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>cm_test_suite</test_depend>
  <test_depend>pal_statistics_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
